/ref-proj
.DS_Store

# Personal dev-session state / debug artifacts — not meant to be shared
# (exported layout snapshots, scratch test files, debug logs). Keeps
# .cursor/skills/ itself trackable, only ignores its debug-*.log output.
/.workspace/
/test/
.cursor/debug-*.log

# Godot's own per-machine import cache (not portable, regenerated on
# first open/export) and the exported Web build (~40MB, regenerate with
# electron/test-fixtures/godot-demo/export.sh — see docs/ROADMAP.md's
# Phase 2 checklist). Only the small source project is tracked.
electron/test-fixtures/godot-demo/.godot/
electron/test-fixtures/godot-demo-web/

# Local Godot CLI (npm run ensure:godot)
electron/.tools/

# Per-tab layout export written by the Electron app during dev.
electron/.workspace/
