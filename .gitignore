/ref-proj/*
!/ref-proj/README.md
.DS_Store
**/node_modules/

# PKMS Web / Cloudflare local state
apps/pkms-web/.wrangler/
apps/pkms-web/.react-router/
apps/pkms-web/build/
apps/pkms-server/.wrangler/
apps/pkms-server/.dev.vars
apps/pkms-server/.dev.vars.*
!apps/pkms-server/.dev.vars.example
apps/pkms-web/.dev.vars
apps/pkms-web/.dev.vars.*
apps/workspace-server/.dev.vars
apps/workspace-server/.dev.vars.*
!apps/workspace-server/.dev.vars.example
apps/workspace-server/.wrangler/

# PKMS iOS generated state
apps/pkms-ios/DerivedData/
apps/pkms-ios/build/
apps/pkms-ios/build-sim/
apps/pkms-ios/.build/
apps/pkms-ios/Frameworks/*.xcframework
apps/pkms-ios/**/xcuserdata/
apps/pkms-ios/**/*.xcuserstate
apps/android-data-node/.gradle/
apps/android-data-node/.artifacts/
apps/android-data-node/app/build/
apps/android-data-node/build/
apps/pkms-ios/legacy/v1/data/
apps/pkms-ios/legacy/v1/AgentRuntime/Vendor/
apps/pkms-ios/legacy/v1/AgentRuntime/RuntimeTemplate/vendor/
apps/pkms-ios/legacy/v1/AgentRuntime/RuntimeTemplate/*.tgz

# PKMS Rust build artifacts
packages/pkms-core/target/

# Rust/Cargo build artifacts (local only — .d dep files are misclassified as Makefile on GitHub)
target/

# Scratch notes (local only)
untitled*.md

# Personal dev-session state / debug artifacts — not meant to be shared
# (exported layout snapshots, scratch test files, debug logs).
/.workspace/
/test/
.cursor/debug-*.log

# Agent skills Python virtualenv (see .agents/README.md, npm run agents:python:setup)
.agents/.venv/

# Godot's own per-machine import cache (not portable, regenerated on
# first open/export) and the exported Web build (~40MB, regenerate with
# apps/workspace/test-fixtures/godot-demo/export.sh — see docs/ROADMAP.md's
# Phase 2 checklist). Only the small source project is tracked.
apps/workspace/test-fixtures/godot-demo/.godot/
apps/workspace/test-fixtures/godot-demo-web/

# Local Godot CLI (npm run ensure:godot)
apps/workspace/.tools/

# Per-tab layout export written by the Electron app during dev.
apps/workspace/.workspace/
