{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace.dev/schemas/world-engine.schema.json",
  "title": "World Engine Scene",
  "description": "Declarative scene geometry and scripts. Runtime simulation state (sim_var / metrics) is not serialized here — see world-engine-rhai-api.md v3.",
  "type": "object",
  "properties": {
    "gravity": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "time_scale": { "type": "number", "minimum": 0 },
    "sim_seed": {
      "type": "integer",
      "minimum": 0,
      "description": "RNG seed for Rhai rand() / rand_range() (default 1)"
    },
    "entry_script": { "type": "string" },
    "active_scene": { "type": "string" },
    "show_grid": { "type": "boolean" },
    "show_axes": { "type": "boolean" },
    "input_map": { "type": "object", "additionalProperties": true },
    "camera": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": { "const": "orbit" },
            "distance": { "type": "number" },
            "yaw": { "type": "number" },
            "pitch": { "type": "number" }
          },
          "required": ["mode"]
        },
        {
          "type": "object",
          "properties": {
            "mode": { "const": "follow" },
            "target": { "type": "string" },
            "offset": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": ["mode", "target"]
        },
        {
          "type": "object",
          "properties": {
            "mode": { "const": "fixed" },
            "position": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 3,
              "maxItems": 3
            },
            "look_at": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": ["mode", "position"]
        },
        {
          "type": "object",
          "properties": {
            "mode": { "const": "fly" },
            "position": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 3,
              "maxItems": 3
            },
            "yaw": { "type": "number" },
            "pitch": { "type": "number" }
          },
          "required": ["mode", "position"]
        }
      ]
    },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity" }
    },
    "joints": { "type": "array" },
    "mesh": { "type": "string" }
  },
  "required": ["entities"],
  "$defs": {
    "entity": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "position": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
        "rotation": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
        "velocity": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
        "body_type": { "enum": ["dynamic", "fixed", "kinematic", "none"] },
        "shape": { "enum": ["cuboid", "sphere"] },
        "half_extents": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
        "radius": { "type": "number" },
        "color": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
        "script": { "type": "string" },
        "script_mode": { "enum": ["kinematic", "force", "impulse"] },
        "trigger": { "type": "boolean" },
        "mesh": { "enum": ["cube", "sphere", "cuboid", "loaded", "gltf"] },
        "mass": { "type": "number" },
        "friction": { "type": "number" },
        "collision_layer": { "type": "integer", "minimum": 0, "maximum": 15 },
        "collision_mask": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "properties": { "type": "object", "additionalProperties": true },
        "pick_half_extents": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        },
        "components": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        }
      }
    }
  }
}
