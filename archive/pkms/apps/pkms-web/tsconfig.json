{
  "include": ["**/*", ".react-router/types/**/*"],
  "exclude": ["prototypes/google-drive-direct/**"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@pkms/client/*": ["../../packages/pkms-client/src/*"],
      "@pkms/google-drive": ["../../packages/pkms-google-drive/src/index.ts"],
      "@pkms/google-drive/*": ["../../packages/pkms-google-drive/src/*"]
    },
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["@cloudflare/workers-types", "vite/client"]
  }
}
