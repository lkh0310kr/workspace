; Engine configuration file.
; This is a stripped-down demo project — just enough to verify the
; workspace-engine:// protocol against a real Godot Web export, not a
; real game. See docs/ROADMAP.md's Phase 2 checklist.

config_version=5

[application]

config/name="EngineBundleDemo"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
