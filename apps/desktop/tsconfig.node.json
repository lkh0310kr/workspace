{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": ["electron.vite.config.*", "src/main/**/*", "src/preload/**/*", "src/shared/**/*"],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"],
    "baseUrl": ".",
    "paths": {
      "@workspace/home": ["../../packages/home/src/index.ts"],
      "@workspace/home/*": ["../../packages/home/src/*"],
      "@workspace/terminal/*": ["../../packages/terminal/src/*"],
      "@workspace/ui": ["../../packages/ui/src/index.ts"],
      "@workspace/ui/Popover": [
        "../../packages/ui/src/popover/Popover.tsx"
      ],
      "@workspace/ui/ContextMenu": [
        "../../packages/ui/src/context-menu/ContextMenu.tsx"
      ],
      "@workspace/ui/MenuList": [
        "../../packages/ui/src/menu-list/MenuList.tsx"
      ],
      "@workspace/ui/context-menu.css": [
        "../../packages/ui/src/context-menu/context-menu.css"
      ],
      "@workspace/ui/*": ["../../packages/ui/src/*"],
      "@xterm/*": ["node_modules/@xterm/*"]
    }
  }
}
