{
  "name": "workspace-app",
  "version": "0.1.0",
  "description": "Personal terminal/editor/browser workspace app",
  "main": "./out/main/index.js",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "japanese:import": "node scripts/japanese/import-dictionary.mjs",
    "japanese:import:fixtures": "node scripts/japanese/import-fixtures.mjs",
    "start": "node scripts/with-linux-ime.mjs electron-vite preview",
    "dev": "node scripts/kill-dev.mjs && node scripts/with-linux-ime.mjs electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "node node_modules/electron/install.js && node scripts/apply-xterm-patch.mjs && electron-builder install-app-deps && node scripts/fix-native-exec-bits.mjs",
    "build:unpack": "npm run build && electron-builder --dir",
    "prebuild:win": "node scripts/stage-world-engine-win.mjs",
    "prebuild:win:dir": "node scripts/stage-world-engine-win.mjs",
    "build:win": "npm run build && electron-builder --win",
    "build:win:dir": "npm run build && electron-builder --win --dir",
    "build:native:embed": "cargo build --release --manifest-path ../native/world-engine-electron-embed/Cargo.toml && node scripts/stage-world-engine-embed.mjs",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@types/better-sqlite3": "^7.6.13",
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/addon-fit": "0.12.0-beta.287",
    "@xterm/addon-ligatures": "0.11.0-beta.287",
    "@xterm/addon-search": "0.17.0-beta.287",
    "@xterm/addon-serialize": "0.15.0-beta.287",
    "@xterm/addon-unicode11": "0.10.0-beta.287",
    "@xterm/addon-web-links": "0.13.0-beta.287",
    "@xterm/addon-webgl": "0.20.0-beta.286",
    "@xterm/headless": "^6.1.0-beta.287",
    "@xterm/xterm": "6.1.0-beta.287",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^11.10.0",
    "flexlayout-react": "^0.10.5",
    "node-pty": "^1.1.0",
    "rss-parser": "^3.13.0",
    "xml2js": "^0.6.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/xml2js": "^0.4.14",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^42.10.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^26.1.0",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^3.2.4"
  }
}
