{
  "name": "workspace",
  "private": true,
  "workspaces": [
    "apps/pkms-web",
    "apps/pkms-server",
    "apps/workspace-server",
    "packages/pkms-client",
    "packages/pkms-protocol"
  ],
  "scripts": {
    "postinstall": "npm install --prefix apps/workspace-app",
    "dev": "npm run dev --prefix apps/workspace-app",
    "pkms:web:dev": "npm run dev --workspace @pkms/web",
    "pkms:web:build": "npm run build --workspace @pkms/web",
    "pkms:web:deploy": "npm run deploy --workspace @pkms/web",
    "pkms:web:typecheck": "npm run typecheck --workspace @pkms/web",
    "pkms:server:deploy": "npm run deploy --workspace @pkms/server",
    "pkms:server:typecheck": "npm run typecheck --workspace @pkms/server",
    "workspace:server:deploy": "npm run deploy --workspace @workspace/server",
    "workspace:server:typecheck": "npm run typecheck --workspace @workspace/server",
    "check": "bash scripts/check.sh",
    "check:app": "cd apps/workspace-app && npm run typecheck",
    "agents:python:setup": "node scripts/agents-python-setup.mjs",
    "agents:python": "node scripts/agents-python.mjs"
  }
}
